APP_NAME=StoreUltra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# One log file per day, kept for LOG_DAILY_DAYS days (playbook OPS-53). "single" would let one file grow for ever.
LOG_STACK=daily
# How many daily log files are kept: 14 on a local machine, 30 in production. Older ones are deleted by Laravel.
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# "debug" on a local machine only. In production use "error": debug lines can contain personal data and tokens,
# and `php artisan app:check-production` refuses the server while it is "debug".
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# In production the application connects with a role that can only read and write rows (storeultra_app, created by
# database/postgres/roles.sql), never with "postgres" or a role that owns the tables: it could then drop a table or
# switch off the triggers that keep the audit journal append-only. `php artisan app:check-production` refuses a
# super-user.
# DB_USERNAME=storeultra_app
# DB_PASSWORD=
# The role that owns the tables, used only by `php artisan migrate --database=pgsql_migrator --force` at deployment.
# Leave both empty on a local machine (the migrations then run with DB_USERNAME). Never give them to the running
# application's environment if the deployment tool can hold them apart.
# DB_MIGRATOR_USERNAME=storeultra_migrator
# DB_MIGRATOR_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypts what is stored in the session (playbook SEC-17). Keep it true: `php artisan app:check-production` refuses
# a server where it is false. Changing it logs everybody out once.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Security (config/security.php). A production server refuses to answer when
# one of these is dangerous: see `php artisan app:check-production`.
# ---------------------------------------------------------------------------

# Forces the owner account to set up two-factor authentication before anything
# else. Set to false on a local machine only; never in production.
SECURITY_REQUIRE_OWNER_TWO_FACTOR=true

# Content Security Policy sent with every page. enforce = violations are blocked,
# report-only = only shown in the browser console, off = no header.
# Default: report-only when APP_ENV=local, enforce otherwise.
# SECURITY_CSP=enforce

# Addresses of the reverse proxies in front of the application, comma separated
# (the application then trusts their forwarded address and scheme). Never *.
# Leave empty when there is no proxy.
TRUSTED_PROXIES=

# Writes every change made to reference data (clients, zones, products, prices,
# kits, shops, payment methods, expense and document types, settings) to the
# audit journal. Keep true: production refuses false.
SECURITY_AUDIT_REFERENCE_DATA=true

# Access journal: every page opened by a signed-in user, every refused sign-in
# and every lock-out, with address and browser. Keep true: production refuses
# false. Personal data: mention it in the privacy notice.
SECURITY_ACCESS_LOG=true

# Days the access journal lines are kept before the nightly purge deletes them.
SECURITY_ACCESS_LOG_RETENTION_DAYS=365

# Filesystem disk (config/filesystems.php) receiving the monthly copies of the
# audit journal. The default is a private folder of the server; point it to a
# storage the application can only add to (versioned object store) for a real
# safeguard.
SECURITY_AUDIT_ARCHIVE_DISK=audit-archive

# Months a monthly copy of the audit journal is kept before its file is deleted
# (the small manifest stays). 36 = 3 years.
SECURITY_AUDIT_ARCHIVE_RETENTION_MONTHS=36

# When the disk holding the copies is fuller than this percentage, the oldest
# copies are deleted first. 0 = no limit. Only measurable on a local disk.
SECURITY_AUDIT_ARCHIVE_DISK_MAX_PERCENT=85

# Number of most recent copies never deleted, whatever the age or the disk.
SECURITY_AUDIT_ARCHIVE_MIN_KEEP=3

# ---------------------------------------------------------------------------
# Base data loaded by `php artisan db:seed` (config/app.php)
# ---------------------------------------------------------------------------

# Path of the workbook of the TPE (small businesses) loaded by the seeders.
# Empty = the file kept with the seeders (database/seeders/data). Set it to read
# the file from elsewhere when it must stay out of the code (it holds names and
# phone numbers).
# SEED_TPE_FILE=
