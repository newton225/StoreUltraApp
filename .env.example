# Name of the application, shown in e-mails and page titles.
APP_NAME=StoreUltra
# Environment: "local" on a developer machine, "production" on the server. In
# production the application refuses to start while a setting is dangerous
# (see app:check-production).
APP_ENV=local
# Secret key that encrypts sessions and sensitive data. Generated once (php
# artisan key:generate), never shared; changing it logs everybody out and
# makes encrypted data unreadable.
APP_KEY=
# Shows detailed errors. "true" on a local machine only; MUST be "false" in
# production (otherwise stacks and settings are shown to visitors).
APP_DEBUG=true
# Public address of the application (used by e-mail and file links). In
# production: the https:// address.
APP_URL=http://localhost:8000

# Default interface language: "fr" or "en" (each user can choose their own).
APP_LOCALE=fr
# Language used when a text is missing in the chosen one.
APP_FALLBACK_LOCALE=en
# Language of the fake demo and test data. No effect in production.
APP_FAKER_LOCALE=en_US

# Where the maintenance mode is stored (php artisan down). "file" suits a
# single server.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Strength of the password hashing: higher is safer and slower. 12 is fine; do
# not lower it.
BCRYPT_ROUNDS=12

# Where technical logs go: "stack" groups the channels of LOG_STACK.
LOG_CHANNEL=stack
# One log file per day, kept for LOG_DAILY_DAYS days (playbook OPS-53). "single" would let one file grow for ever.
LOG_STACK=daily
# How many daily log files are kept: 14 on a local machine, 30 in production. Older ones are deleted by Laravel.
LOG_DAILY_DAYS=14
# Channel of the "deprecated function" warnings. "null" ignores them.
LOG_DEPRECATIONS_CHANNEL=null
# "debug" on a local machine only. In production use "error": debug lines can contain personal data and tokens,
# and `php artisan app:check-production` refuses the server while it is "debug".
LOG_LEVEL=debug

# Database: "sqlite" on a developer machine (a plain file), "pgsql"
# (PostgreSQL) in production. The other DB_* settings are for PostgreSQL only:
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD (password: never in
# a file of the repository or in a conversation).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# In production the application connects with a role that can only read and write rows (storeultra_app, created by
# database/postgres/roles.sql), never with "postgres" or a role that owns the tables: it could then drop a table or
# switch off the triggers that keep the audit journal append-only. `php artisan app:check-production` refuses a
# super-user.
# DB_USERNAME=storeultra_app
# DB_PASSWORD=
# The role that owns the tables, used only by `php artisan migrate --database=pgsql_migrator --force` at deployment.
# Leave both empty on a local machine (the migrations then run with DB_USERNAME). Never give them to the running
# application's environment if the deployment tool can hold them apart.
# DB_MIGRATOR_USERNAME=storeultra_migrator
# DB_MIGRATOR_PASSWORD=

# Where the sessions of signed-in users are kept: "database" (in the
# database).
SESSION_DRIVER=database
# Minutes of inactivity before automatic sign-out.
SESSION_LIFETIME=120
# Encrypts what is stored in the session (playbook SEC-17). Keep it true: `php artisan app:check-production` refuses
# a server where it is false. Changing it logs everybody out once.
SESSION_ENCRYPT=true
# Path of the session cookie. Leave "/".
SESSION_PATH=/
# Domain of the session cookie. "null" = the current domain; change only to
# share the session between subdomains.
SESSION_DOMAIN=null

# Real-time broadcasting (not used here). Leave "log".
BROADCAST_CONNECTION=log
# Default file disk. "local" = private folder of the server (attachments,
# documents, proofs).
FILESYSTEM_DISK=local
# Queue of the long tasks. "database" needs a "php artisan queue:work" process
# running in production.
QUEUE_CONNECTION=database

# Where the cache is kept. "database" suits a single server.
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached address. Not used here.
MEMCACHED_HOST=127.0.0.1

# Redis client. Not used here (the REDIS_* settings only matter if the cache
# or the queue moves to Redis).
REDIS_CLIENT=phpredis
# Redis server address. Not used here.
REDIS_HOST=127.0.0.1
# Redis password. Not used here.
REDIS_PASSWORD=null
# Redis port. Not used here.
REDIS_PORT=6379

# How e-mails leave: "log" only writes them to the log (nothing is sent:
# password reset links never arrive); "smtp" really sends them. Set it in
# production with the MAIL_* settings below.
MAIL_MAILER=log
# Encryption of the SMTP connection: "smtps" (port 465) or empty/"null" (port
# 587 is negotiated as STARTTLS).
MAIL_SCHEME=null
# SMTP server of the e-mail provider.
MAIL_HOST=127.0.0.1
# Port of the SMTP server (usually 587 or 465).
MAIL_PORT=2525
# SMTP user name given by the e-mail provider.
MAIL_USERNAME=null
# SMTP password: secret, never in a file of the repository.
MAIL_PASSWORD=null
# Sender address of the e-mails the application sends.
MAIL_FROM_ADDRESS="hello@example.com"
# Sender name of the e-mails.
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage (backups or files outside the server): access key.
# Only if an S3 disk is used.
AWS_ACCESS_KEY_ID=
# S3 storage: secret key. Secret, never in a file of the repository.
AWS_SECRET_ACCESS_KEY=
# S3 storage: region of the bucket.
AWS_DEFAULT_REGION=us-east-1
# S3 storage: name of the bucket.
AWS_BUCKET=
# S3 storage: "true" for some S3-compatible services (MinIO…), "false" for
# Amazon.
AWS_USE_PATH_STYLE_ENDPOINT=false

# Name of the application in the browser (taken from APP_NAME). Do not change.
VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Security (config/security.php). A production server refuses to answer when
# one of these is dangerous: see `php artisan app:check-production`.
# ---------------------------------------------------------------------------

# Forces the owner account to set up two-factor authentication before anything
# else. Set to false on a local machine only; never in production.
SECURITY_REQUIRE_OWNER_TWO_FACTOR=true

# Content Security Policy sent with every page. enforce = violations are blocked,
# report-only = only shown in the browser console, off = no header.
# Default: report-only when APP_ENV=local, enforce otherwise.
# SECURITY_CSP=enforce

# Addresses of the reverse proxies in front of the application, comma separated
# (the application then trusts their forwarded address and scheme). Never *.
# Leave empty when there is no proxy.
TRUSTED_PROXIES=

# Writes every change made to reference data (clients, zones, products, prices,
# kits, shops, payment methods, expense and document types, settings) to the
# audit journal. Keep true: production refuses false.
SECURITY_AUDIT_REFERENCE_DATA=true

# Access journal: every page opened by a signed-in user, every refused sign-in
# and every lock-out, with address and browser. Keep true: production refuses
# false. Personal data: mention it in the privacy notice.
SECURITY_ACCESS_LOG=true

# Days the access journal lines are kept before the nightly purge deletes them.
SECURITY_ACCESS_LOG_RETENTION_DAYS=365

# Filesystem disk (config/filesystems.php) receiving the monthly copies of the
# audit journal. The default is a private folder of the server; point it to a
# storage the application can only add to (versioned object store) for a real
# safeguard.
SECURITY_AUDIT_ARCHIVE_DISK=audit-archive

# Months a monthly copy of the audit journal is kept before its file is deleted
# (the small manifest stays). 36 = 3 years.
SECURITY_AUDIT_ARCHIVE_RETENTION_MONTHS=36

# When the disk holding the copies is fuller than this percentage, the oldest
# copies are deleted first. 0 = no limit. Only measurable on a local disk.
SECURITY_AUDIT_ARCHIVE_DISK_MAX_PERCENT=85

# Number of most recent copies never deleted, whatever the age or the disk.
SECURITY_AUDIT_ARCHIVE_MIN_KEEP=3

# ---------------------------------------------------------------------------
# Base data loaded by `php artisan db:seed` (config/app.php)
# ---------------------------------------------------------------------------

# Path of the workbook of the TPE (small businesses) loaded by the seeders.
# Empty = the file kept with the seeders (database/seeders/data). Set it to read
# the file from elsewhere when it must stay out of the code (it holds names and
# phone numbers).
# SEED_TPE_FILE=

# Backup (`php artisan app:backup`, every day at 01:30): the database and the
# private files in one archive encrypted with a password, then the retention
# rules delete the old copies. Restoring is done by hand, see the README.
#
# Filesystem disk (config/filesystems.php) receiving the archives. The default
# is a folder of the server, which does not survive losing the server: point it
# to a storage elsewhere (S3 compatible bucket, SFTP) in production.
BACKUP_DISK=backups

# Password of the archive (AES-256), needed to restore it. REQUIRED: without it
# the command refuses to run. Keep a copy somewhere other than the server; lose
# it and the backups cannot be opened.
BACKUP_PASSWORD=

# PostgreSQL only: the read-only role of the backup (database/postgres/roles.sql),
# never the role of the application, and the path of pg_dump, which must be at
# least as recent as the database server.
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
BACKUP_PG_DUMP=pg_dump

# Retention: every copy for 7 days, then one a day up to 30 days, one a week up
# to 90 days, one a month up to 365 days, then nothing. The last value is also
# how long a deleted record can survive in the backups.
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_WEEKLY_DAYS=90
BACKUP_KEEP_MAX_DAYS=365


# Legal texts (legal notice, privacy policy, terms of use, public pages /legal/...).
# The company itself comes from the "Mon entreprise" page; these are the rest.
# A blank prints "[à compléter]" in the texts and stops a production server
# (`php artisan app:check-production`).
#
# The host of the server (name, address, country) and the mail provider: both
# receive personal data and must be named in the privacy policy.
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_COUNTRY=
LEGAL_MAIL_PROVIDER=

# Address for requests about personal data. Empty = the e-mail of the company.
LEGAL_PRIVACY_EMAIL=

# Country whose law applies, its data protection law (name and number) and the
# authority people can complain to. Ask a lawyer: nothing here is guessed.
LEGAL_COUNTRY=
LEGAL_DATA_PROTECTION_LAW=
LEGAL_DATA_PROTECTION_AUTHORITY=

# The version of the texts a lawyer has read and approved (the "version" of
# config/legal.php, a date). While it differs from the current version the
# production check refuses. The texts are drafts from what the application does,
# NOT legal advice.
LEGAL_REVIEWED_VERSION=
